# =================================================================
# Dubai BusinessOne AI — Environment Configuration Template
# =================================================================

APP_NAME="Dubai BusinessOne AI"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Security & Authentication
SECRET_KEY="dubai-businessone-production-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_DEFAULT_EMAIL="admin@businessone.dubai.ae"
ADMIN_DEFAULT_PASSWORD="DubaiBizOne2026!Secure"

# Persistence & Storage
DATABASE_URL="sqlite+aiosqlite:///./dubai_businessone.db"
# Optional Postgres: DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/dubai_businessone"
REDIS_URL="redis://localhost:6379/0"

# Model Routing & LLM Provider Settings
DEFAULT_LLM_PROVIDER="hybrid"
OPEN_WEIGHT_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"
VLLM_ENDPOINT="http://localhost:8000/v1"
GEMINI_API_KEY=""
OPENAI_COMPATIBLE_ENDPOINT=""
MAX_TOKENS_PER_TASK=2048

# Memory & Caching
L1_CACHE_TTL_SECONDS=86400
FRESHNESS_MAX_AGE_DAYS=30

# Multi-Channel Notifications
ENABLE_NOTIFICATIONS=true
WHATSAPP_SANDBOX=true
TEAMS_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
